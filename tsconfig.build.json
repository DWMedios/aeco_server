{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@common/*": ["src/common/*"],
      "@shared/*": ["src/shared/*"],
      "@users/*": ["src/users/*"],
      "@auth/*": ["src/auth/*"],
      "@rewards/*": ["src/rewards/*"],
      "@upload/*": ["src/upload/*"],
      "@company/*": ["src/company/*"],
      "@aecos/*": ["src/aecos/*"],
      "@products/*": ["src/products/*"],
    }
  },
  "include": ["src/**/*.ts", "src/shared/validators/blacklist.json"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"],
}
